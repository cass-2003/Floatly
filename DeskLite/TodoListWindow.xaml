<Window x:Class="DeskLite.TodoListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floatly TodoList"
        Width="760"
        Height="720"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#F5F7FA"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="TodoIconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TodoSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderThickness="1" CornerRadius="24" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0" Padding="24,20,18,16"
                    MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="◎" FontSize="22" Foreground="{DynamicResource TodoAccentBrush}"
                                       Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="HeaderText" Text="Floatly TodoList" FontSize="24"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="HeaderSubtitleText" Text="专注当下，完成更多" FontSize="12"
                                   Margin="32,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="MinimizeBtn" Style="{StaticResource TodoIconButton}"
                                Content="－" Click="Minimize_Click" ToolTip="最小化" />
                        <Button x:Name="CloseBtn" Style="{StaticResource TodoIconButton}"
                                Content="×" Click="Close_Click" ToolTip="关闭" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,0,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SearchShell" Grid.Row="0" Grid.Column="0" Height="42"
                        CornerRadius="14" Padding="14,0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌕" FontSize="18" Foreground="{DynamicResource TodoMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,1" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 Padding="0" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Border>

                <Button x:Name="AddTaskBtn" Grid.Row="0" Grid.Column="1" Height="42" MinWidth="118"
                        Margin="12,0,0,0" Padding="16,0" Click="AddTask_Click" Cursor="Hand"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="＋" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="新建任务" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel x:Name="FilterPanel" Grid.Row="1" Grid.ColumnSpan="2"
                            Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="FilterAllBtn" Content="全部" Padding="15,7" Margin="0,0,8,0"
                            Click="FilterAll_Click" Cursor="Hand" BorderThickness="1" />
                    <Button x:Name="FilterTodayBtn" Content="今天" Padding="15,7" Margin="0,0,8,0"
                            Click="FilterToday_Click" Cursor="Hand" BorderThickness="1" />
                    <Button x:Name="FilterTomorrowBtn" Content="明天" Padding="15,7" Margin="0,0,8,0"
                            Click="FilterTomorrow_Click" Cursor="Hand" BorderThickness="1" />
                    <Button x:Name="FilterWeekBtn" Content="本周" Padding="15,7" Margin="0,0,8,0"
                            Click="FilterWeek_Click" Cursor="Hand" BorderThickness="1" />
                    <Button x:Name="FilterDoneBtn" Content="已完成" Padding="15,7"
                            Click="FilterDone_Click" Cursor="Hand" BorderThickness="1" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="24,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <Border x:Name="TaskPanel" Grid.Column="0" CornerRadius="20" BorderThickness="1" Padding="0">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="0">
                            <StackPanel x:Name="TodoSectionsPanel" Margin="18" />
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed" Margin="24">
                            <Border Width="74" Height="74" CornerRadius="22" HorizontalAlignment="Center"
                                    Background="{DynamicResource TodoCountBadgeBrush}" Margin="0,0,0,16">
                                <TextBlock Text="☑" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TodoAccentBrush}" />
                            </Border>
                            <TextBlock x:Name="EmptyHintText" Text="今天还没有任务" FontSize="17"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptySubText" Text="点击右上角 + 按钮添加任务" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,7,0,16" />
                            <Button x:Name="EmptyAddBtn" Content="＋ 新建任务" Height="34" MinWidth="120"
                                    Click="AddTask_Click" BorderThickness="0" Cursor="Hand" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border x:Name="FocusCard" CornerRadius="18" BorderThickness="1" Padding="18" MinHeight="154">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                                <TextBlock Text="◎" FontSize="18" Foreground="{DynamicResource TodoAccentBrush}"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="当前最重要" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TodoPrimaryBrush}" />
                                    <TextBlock x:Name="FocusMetaText" Text="今日聚焦" FontSize="11"
                                               Foreground="{DynamicResource TodoMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Border x:Name="FocusTaskCard" CornerRadius="12" BorderThickness="1" Padding="12">
                                <StackPanel>
                                    <TextBlock x:Name="FocusTitleText" Text="暂无聚焦任务" FontSize="14"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="FocusDetailText" Text="置顶任务会优先出现在这里" FontSize="11"
                                               Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="StatsCard" CornerRadius="18" BorderThickness="1" Padding="18"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="任务统计" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TodoPrimaryBrush}" />
                            <TextBlock Text="本周任务完成情况" FontSize="11"
                                       Foreground="{DynamicResource TodoMutedBrush}" Margin="0,3,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="58" Height="58">
                                    <Ellipse Stroke="{DynamicResource TodoDividerBrush}" StrokeThickness="7" />
                                    <Path x:Name="StatsArc" Stroke="{DynamicResource TodoAccentBrush}"
                                          StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <TextBlock x:Name="CompletionText" Text="0%" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <UniformGrid Grid.Column="1" Columns="3" Rows="1" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock x:Name="TotalCountText" Text="0" FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="全部" FontSize="10" Foreground="{DynamicResource TodoMutedBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="ActiveCountText" Text="0" FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="进行中" FontSize="10" Foreground="{DynamicResource TodoMutedBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="DoneCountText" Text="0" FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="完成" FontSize="10" Foreground="{DynamicResource TodoMutedBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border x:Name="FooterBar" Grid.Row="3" Margin="24,18,24,22" CornerRadius="16"
                    BorderThickness="1" Padding="14,10">
                <Grid>
                    <TextBlock x:Name="FooterHintText" Text="双击标题编辑 · 勾选完成 · 星标设为聚焦"
                               FontSize="11" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="交互效果" FontSize="11" Foreground="{DynamicResource TodoMutedBrush}"
                                   Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Button x:Name="FooterAddBtn" Content="＋ 新建任务" Height="30" MinWidth="100"
                                Click="AddTask_Click" BorderThickness="0" Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
